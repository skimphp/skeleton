{
  "name": "skim/skeleton",
  "description": "SKIM Framework — project skeleton",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "skim/framework": "^0.1"
  },
  "require-dev": {
    "pestphp/pest": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "prefer-stable": true
}
