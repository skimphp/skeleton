APP_NAME="SKIM App"
APP_ENV=local
APP_DEBUG=true
APP_KEY=

# Cache — file driver works without external services.
# Uncomment Redis block below when you have a Redis server running.
CACHE_DRIVER=file

# Session — file driver works without external services.
# Uncomment Redis block below when you have a Redis server running.
SESSION_DRIVER=file

# Logging
LOG_CHANNEL=file
LOG_LEVEL=debug

# --- Database ---
# Not needed for Hello World. Uncomment and configure when you run migrations.
# SQLite works out of the box with zero setup:
# DB_DRIVER=sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=:memory:
# DB_USER=root
# DB_PASS=

# MySQL / PostgreSQL — uncomment for Docker or local database server:
# DB_DRIVER=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_NAME=skim_dev
# DB_USER=skim
# DB_PASS=secret

# Alternative database (PostgreSQL) — optional second connection.
# Named "alt" for alternative — a secondary DB kept separate from the
# primary transactional DB so heavy queries cannot slow down the main app.
# Any name works — add more connections in config/db.php and reference them via
# Db::row(..., connection: 'alt').
# ALT_DB_HOST=pgsql
# ALT_DB_PORT=5432
# ALT_DB_NAME=skim_alt
# ALT_DB_USER=skim
# ALT_DB_PASS=secret

# --- Redis ---
# Uncomment when you have a Redis server running (e.g. via Docker):
# CACHE_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASS=
# REDIS_DB=0

# SESSION_DRIVER=redis
# SESSION_PREFIX=sess_
